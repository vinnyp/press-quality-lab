{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judge-output.schema.json",
  "title": "Judge output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rulebook_version",
    "outcome",
    "rejected_by",
    "exit_code",
    "scope",
    "verdict",
    "own_verdict",
    "counts",
    "stale_markers",
    "checks",
    "dimensions",
    "groups",
    "comparison",
    "set_aside",
    "earlier_pools",
    "anchor"
  ],
  "properties": {
    "rulebook_version": {
      "const": "1.0"
    },
    "outcome": {
      "enum": [
        "verdict",
        "rejected",
        "anchored",
        "refused"
      ]
    },
    "rejected_by": {
      "enum": [
        "X1",
        "X2",
        "X3",
        "X4",
        "X5",
        "X6",
        "X7",
        "X8",
        "X9",
        "X10",
        "X11",
        "X12",
        null
      ]
    },
    "exit_code": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5
      ]
    },
    "scope": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "enum": [
          "conformance",
          "destructive",
          "steering",
          "compare"
        ]
      },
      "uniqueItems": true
    },
    "verdict": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/verdict"
        }
      ]
    },
    "own_verdict": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/verdict"
        }
      ]
    },
    "counts": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "xfail",
            "xpass"
          ],
          "properties": {
            "xfail": {
              "type": "integer",
              "minimum": 0
            },
            "xpass": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "stale_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record",
          "dimension"
        ],
        "properties": {
          "record": {
            "type": "string"
          },
          "dimension": {
            "enum": [
              "availability",
              "execution",
              "graceful-failure",
              "robustness",
              "response-correctness",
              "determinism",
              "cli-mcp-parity",
              "provenance-honesty",
              "completeness-signaling",
              "output-conformance",
              "flag-conformance",
              "bounding",
              "discoverability",
              "error-message-quality",
              "token-economy",
              "side-effect-integrity",
              "idempotency",
              "destructive-guard",
              "pii-secret-hygiene",
              "steering",
              "tool-description-efficacy"
            ]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result",
          "rule",
          "reason",
          "detail",
          "k",
          "n",
          "to_run",
          "lower",
          "upper",
          "d_lo",
          "d_hi"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "unobserved",
              "failed",
              "failed_expected",
              "held_crediting",
              "held_non_crediting",
              "out_of_scope"
            ]
          },
          "rule": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(C[1-8]|P[013-5]|K[1-4])$"
          },
          "reason": {
            "enum": [
              "arms_not_comparable",
              "computation_failed",
              "could_not_start",
              "earlier_step_failed",
              "empty_target",
              "error_cap",
              "harness_fault",
              "input_missing",
              "interval_undecided",
              "judgement_unverified",
              "live_not_run",
              "network_attempted",
              "network_unverifiable",
              "no_evidence",
              "placeholder_unfilled",
              "precondition_unmet",
              "trials_short",
              null
            ]
          },
          "detail": {
            "enum": [
              "regressed",
              "improved",
              "no_material_change",
              null
            ]
          },
          "k": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "n": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "to_run": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "lower": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{6}$",
            "not": {
              "const": "-0.000000"
            }
          },
          "upper": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{6}$",
            "not": {
              "const": "-0.000000"
            }
          },
          "d_lo": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{6}$",
            "not": {
              "const": "-0.000000"
            }
          },
          "d_hi": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{6}$",
            "not": {
              "const": "-0.000000"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "out_of_scope"
                }
              }
            },
            "then": {
              "properties": {
                "rule": {
                  "type": "null"
                },
                "reason": {
                  "type": "null"
                },
                "detail": {
                  "type": "null"
                },
                "k": {
                  "type": "null"
                },
                "n": {
                  "type": "null"
                },
                "to_run": {
                  "type": "null"
                },
                "lower": {
                  "type": "null"
                },
                "upper": {
                  "type": "null"
                },
                "d_lo": {
                  "type": "null"
                },
                "d_hi": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "rule": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "state",
          "rule",
          "reason"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "availability",
              "execution",
              "graceful-failure",
              "robustness",
              "response-correctness",
              "determinism",
              "cli-mcp-parity",
              "provenance-honesty",
              "completeness-signaling",
              "output-conformance",
              "flag-conformance",
              "bounding",
              "discoverability",
              "error-message-quality",
              "token-economy",
              "side-effect-integrity",
              "idempotency",
              "destructive-guard",
              "pii-secret-hygiene",
              "steering",
              "tool-description-efficacy"
            ]
          },
          "state": {
            "enum": [
              "OUT-OF-SCOPE",
              "RED",
              "N/A",
              "HARNESS",
              "XFAIL",
              "XPASS",
              "GREEN",
              "UNCOVERED"
            ]
          },
          "rule": {
            "type": "string",
            "pattern": "^D[0-8]$"
          },
          "reason": {
            "enum": [
              "placeholder_unfilled",
              "scope_not_requested",
              "live_not_run",
              null
            ]
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group",
          "state",
          "rule"
        ],
        "properties": {
          "group": {
            "enum": [
              "Operability",
              "Correctness",
              "Conformance",
              "Usability",
              "Safety",
              "Steering"
            ]
          },
          "state": {
            "enum": [
              "OUT-OF-SCOPE",
              "RED",
              "GAPPED",
              "KNOWN-DEFECT",
              "GREEN",
              "N/A"
            ]
          },
          "rule": {
            "type": "string",
            "pattern": "^G[1-6]$"
          }
        }
      }
    },
    "comparison": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "rule",
            "next_action",
            "entries",
            "new"
          ],
          "properties": {
            "result": {
              "enum": [
                "none",
                "regressed",
                "not_measured",
                "not_regressed"
              ]
            },
            "rule": {
              "enum": [
                "B1",
                "R1",
                "R2",
                "R3"
              ]
            },
            "next_action": {
              "enum": [
                "re_anchor",
                null
              ]
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "check_id",
                  "class",
                  "rule"
                ],
                "properties": {
                  "check_id": {
                    "type": "string"
                  },
                  "class": {
                    "enum": [
                      "set_aside",
                      "missing",
                      "not_compared",
                      "regressed",
                      "improved",
                      "same"
                    ]
                  },
                  "rule": {
                    "type": "string",
                    "pattern": "^(B2|E[1-9]|E9a|E9b|E10|E11)$"
                  }
                }
              }
            },
            "new": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "set_aside": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "arm",
          "condition",
          "trial_index",
          "reason"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "arm": {
            "enum": [
              "A",
              "B",
              null
            ]
          },
          "condition": {
            "type": "string"
          },
          "trial_index": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "enum": [
              "wrong_tier",
              "other_arm",
              "earlier_pool"
            ]
          }
        }
      }
    },
    "earlier_pools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "arm",
          "condition",
          "k",
          "n",
          "rule"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "arm": {
            "enum": [
              "A",
              "B",
              null
            ]
          },
          "condition": {
            "type": "string"
          },
          "k": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "n": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "rule": {
            "type": "string",
            "pattern": "^P[013-5]$"
          }
        }
      }
    },
    "anchor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "rule",
            "reason",
            "checks",
            "baseline",
            "replaced"
          ],
          "properties": {
            "result": {
              "enum": [
                "anchored",
                "refused"
              ]
            },
            "rule": {
              "type": "string",
              "pattern": "^N[1-7]$"
            },
            "reason": {
              "enum": [
                "test_run",
                "red",
                "not_measured",
                "stale_marker",
                "unretired_check",
                "unaccepted_regression",
                null
              ]
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "baseline": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/baseline"
                }
              ]
            },
            "replaced": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/baseline_entry"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "verdict": {
      "enum": [
        {
          "token": "PASSED",
          "sub_label": null,
          "plain": "green"
        },
        {
          "token": "FAILED",
          "sub_label": null,
          "plain": "red"
        },
        {
          "token": "PROVISIONAL",
          "sub_label": "known-defects",
          "plain": "known_defect"
        },
        {
          "token": "PROVISIONAL",
          "sub_label": "gaps",
          "plain": "not_measured"
        }
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/baseline_entry"
          }
        }
      }
    },
    "baseline_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "kind",
        "dimension",
        "result",
        "rulebook_version",
        "tier",
        "condition",
        "k",
        "n"
      ],
      "properties": {
        "check_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "plain",
            "prompt",
            "comparison"
          ]
        },
        "dimension": {
          "enum": [
            "availability",
            "execution",
            "graceful-failure",
            "robustness",
            "response-correctness",
            "determinism",
            "cli-mcp-parity",
            "provenance-honesty",
            "completeness-signaling",
            "output-conformance",
            "flag-conformance",
            "bounding",
            "discoverability",
            "error-message-quality",
            "token-economy",
            "side-effect-integrity",
            "idempotency",
            "destructive-guard",
            "pii-secret-hygiene",
            "steering",
            "tool-description-efficacy"
          ]
        },
        "result": {
          "enum": [
            "held",
            "failed"
          ]
        },
        "rulebook_version": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "offline",
            "live",
            "replay",
            "scripted",
            "mixed"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "properties": {
          "rejected_by": {
            "type": "string"
          },
          "exit_code": {
            "const": 2
          },
          "scope": {
            "type": "null"
          },
          "verdict": {
            "type": "null"
          },
          "own_verdict": {
            "type": "null"
          },
          "counts": {
            "type": "null"
          },
          "comparison": {
            "type": "null"
          },
          "anchor": {
            "type": "null"
          },
          "checks": {
            "maxItems": 0
          },
          "dimensions": {
            "maxItems": 0
          },
          "groups": {
            "maxItems": 0
          },
          "stale_markers": {
            "maxItems": 0
          },
          "set_aside": {
            "maxItems": 0
          },
          "earlier_pools": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "rejected_by": {
            "type": "null"
          },
          "scope": {
            "type": "array"
          },
          "counts": {
            "type": "object"
          },
          "dimensions": {
            "minItems": 21,
            "maxItems": 21
          },
          "groups": {
            "minItems": 6,
            "maxItems": 6
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "verdict"
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "type": "object"
          },
          "own_verdict": {
            "type": "null"
          },
          "anchor": {
            "type": "null"
          },
          "comparison": {
            "type": "object"
          },
          "exit_code": {
            "enum": [
              0,
              1,
              3,
              4
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "anchored",
              "refused"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "type": "null"
          },
          "own_verdict": {
            "type": "object"
          },
          "anchor": {
            "type": "object"
          },
          "comparison": {
            "type": "null"
          },
          "exit_code": {
            "enum": [
              0,
              5
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "verdict"
          },
          "verdict": {
            "type": "object",
            "properties": {
              "token": {
                "const": "PASSED"
              }
            },
            "required": [
              "token"
            ]
          }
        },
        "required": [
          "outcome",
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "verdict"
          },
          "verdict": {
            "type": "object",
            "properties": {
              "token": {
                "const": "FAILED"
              }
            },
            "required": [
              "token"
            ]
          }
        },
        "required": [
          "outcome",
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "verdict"
          },
          "verdict": {
            "type": "object",
            "properties": {
              "sub_label": {
                "const": "known-defects"
              }
            },
            "required": [
              "sub_label"
            ]
          }
        },
        "required": [
          "outcome",
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "verdict"
          },
          "verdict": {
            "type": "object",
            "properties": {
              "sub_label": {
                "const": "gaps"
              }
            },
            "required": [
              "sub_label"
            ]
          }
        },
        "required": [
          "outcome",
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 4
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "anchored"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          },
          "anchor": {
            "properties": {
              "result": {
                "const": "anchored"
              },
              "rule": {
                "const": "N7"
              },
              "reason": {
                "type": "null"
              },
              "checks": {
                "maxItems": 0
              },
              "baseline": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "refused"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 5
          },
          "anchor": {
            "properties": {
              "result": {
                "const": "refused"
              },
              "rule": {
                "pattern": "^N[1-6]$"
              },
              "reason": {
                "type": "string"
              },
              "baseline": {
                "type": "null"
              },
              "replaced": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
