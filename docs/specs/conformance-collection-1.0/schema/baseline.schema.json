{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baseline.schema.json",
  "title": "Conformance collection 1.0 stored baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline_version",
    "spec_version",
    "rulebook_version",
    "subject_file_digest",
    "baseline",
    "subject_file_path",
    "preimages",
    "created_at"
  ],
  "properties": {
    "baseline_version": {
      "const": "1.0"
    },
    "spec_version": {
      "const": "1.0"
    },
    "rulebook_version": {
      "type": "string",
      "maxLength": 32
    },
    "subject_file_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "kind",
              "dimension",
              "result",
              "rulebook_version",
              "tier",
              "condition",
              "k",
              "n"
            ],
            "properties": {
              "check_id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "plain",
                  "prompt",
                  "comparison"
                ]
              },
              "dimension": {
                "enum": [
                  "availability",
                  "execution",
                  "graceful-failure",
                  "robustness",
                  "response-correctness",
                  "determinism",
                  "cli-mcp-parity",
                  "provenance-honesty",
                  "completeness-signaling",
                  "output-conformance",
                  "flag-conformance",
                  "bounding",
                  "discoverability",
                  "error-message-quality",
                  "token-economy",
                  "side-effect-integrity",
                  "idempotency",
                  "destructive-guard",
                  "pii-secret-hygiene",
                  "steering",
                  "tool-description-efficacy"
                ]
              },
              "result": {
                "enum": [
                  "held",
                  "failed"
                ]
              },
              "rulebook_version": {
                "type": "string"
              },
              "tier": {
                "enum": [
                  "offline",
                  "live",
                  "replay",
                  "scripted",
                  "mixed"
                ]
              },
              "condition": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "k": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "n": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    },
    "subject_file_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "preimages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scheme",
          "probe",
          "runbook",
          "step",
          "index",
          "earlier",
          "dimension",
          "predicate",
          "path",
          "words",
          "offline_args",
          "env",
          "budget_seconds",
          "seed",
          "store",
          "bookkeeping",
          "parameters",
          "expected"
        ],
        "properties": {
          "scheme": {
            "const": "pql-check-id-1"
          },
          "probe": {
            "enum": [
              "discovery",
              "bare",
              "byte_bound",
              "exit_codes",
              "planted_secret",
              "store_unchanged",
              null
            ]
          },
          "runbook": {
            "type": [
              "string",
              "null"
            ]
          },
          "step": {
            "type": [
              "string",
              "null"
            ]
          },
          "index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "earlier": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "dimension": {
            "type": "string"
          },
          "predicate": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "words": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "offline_args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "budget_seconds": {
            "oneOf": [
              {
                "type": [
                  "integer",
                  "null"
                ]
              },
              {
                "$ref": "subject-file.schema.json#/$defs/placeholder"
              }
            ]
          },
          "seed": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              },
              {
                "$ref": "subject-file.schema.json#/$defs/placeholder"
              }
            ]
          },
          "store": {
            "oneOf": [
              {
                "type": [
                  "string",
                  "null"
                ]
              },
              {
                "$ref": "subject-file.schema.json#/$defs/placeholder"
              }
            ]
          },
          "bookkeeping": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parameters": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "declared_count",
                  "commands"
                ],
                "properties": {
                  "declared_count": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "$ref": "subject-file.schema.json#/$defs/placeholder"
                      }
                    ]
                  },
                  "commands": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "exit_codes"
                ],
                "properties": {
                  "exit_codes": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        }
                      },
                      {
                        "$ref": "subject-file.schema.json#/$defs/placeholder"
                      }
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "bound"
                ],
                "properties": {
                  "bound": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "$ref": "subject-file.schema.json#/$defs/placeholder"
                      }
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "kind",
                  "text_sha256",
                  "commands"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "credential",
                      "seeded_state"
                    ]
                  },
                  "text_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "commands": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "words",
                        "offline_args",
                        "env",
                        "budget_seconds"
                      ],
                      "properties": {
                        "words": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "offline_args": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "env": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          }
                        },
                        "budget_seconds": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 1
                            },
                            {
                              "$ref": "subject-file.schema.json#/$defs/placeholder"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "secret"
                ],
                "properties": {
                  "secret": {
                    "$ref": "subject-file.schema.json#/$defs/placeholder"
                  }
                }
              }
            ]
          },
          "expected": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "literal",
                  "precondition"
                ],
                "properties": {
                  "literal": true,
                  "precondition": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/source"
                      }
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "computation",
                  "precondition"
                ],
                "properties": {
                  "computation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "argv",
                      "budget_seconds",
                      "captures",
                      "files"
                    ],
                    "properties": {
                      "argv": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "budget_seconds": {
                        "oneOf": [
                          {
                            "type": "integer",
                            "minimum": 1
                          },
                          {
                            "$ref": "subject-file.schema.json#/$defs/placeholder"
                          }
                        ]
                      },
                      "captures": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "files": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  },
                  "precondition": {
                    "type": "null",
                    "description": "A computed expected value never asserts emptiness (QA9), so it has no precondition."
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "probe": {
                  "const": "discovery"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "$ref": "#/properties/preimages/additionalProperties/properties/parameters/anyOf/1"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "probe": {
                  "const": "bare"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "$ref": "#/properties/preimages/additionalProperties/properties/parameters/anyOf/2"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "probe": {
                  "const": "byte_bound"
                }
              }
            },
            "then": {
              "if": {
                "properties": {
                  "words": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "parameters": {
                    "$ref": "#/properties/preimages/additionalProperties/properties/parameters/anyOf/0"
                  }
                }
              },
              "else": {
                "properties": {
                  "parameters": {
                    "$ref": "#/properties/preimages/additionalProperties/properties/parameters/anyOf/3"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "probe": {
                  "const": "exit_codes"
                }
              }
            },
            "then": {
              "if": {
                "properties": {
                  "words": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "parameters": {
                    "$ref": "#/properties/preimages/additionalProperties/properties/parameters/anyOf/0"
                  }
                }
              },
              "else": {
                "properties": {
                  "parameters": {
                    "allOf": [
                      {
                        "$ref": "#/properties/preimages/additionalProperties/properties/parameters/anyOf/2"
                      },
                      {
                        "properties": {
                          "exit_codes": {
                            "oneOf": [
                              {
                                "type": "array"
                              },
                              {
                                "$ref": "subject-file.schema.json#/$defs/placeholder"
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "probe": {
                  "const": "planted_secret"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "anyOf": [
                    {
                      "$ref": "#/properties/preimages/additionalProperties/properties/parameters/anyOf/0"
                    },
                    {
                      "$ref": "#/properties/preimages/additionalProperties/properties/parameters/anyOf/4"
                    },
                    {
                      "$ref": "#/properties/preimages/additionalProperties/properties/parameters/anyOf/5"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "probe": {
                  "const": "store_unchanged"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "$ref": "#/properties/preimages/additionalProperties/properties/parameters/anyOf/0"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "probe": {
                  "const": null
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "$ref": "#/properties/preimages/additionalProperties/properties/parameters/anyOf/2"
                }
              }
            }
          }
        ]
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "computation"
      ],
      "properties": {
        "computation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "argv",
            "budget_seconds",
            "captures",
            "files"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "budget_seconds": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "$ref": "subject-file.schema.json#/$defs/placeholder"
                }
              ]
            },
            "captures": {
              "type": "array",
              "maxItems": 0,
              "description": "A precondition reads only the pristine seed, so it captures nothing."
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
