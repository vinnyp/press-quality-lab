{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baseline.schema.json",
  "title": "Conformance collection 1.0 stored baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline_version",
    "spec_version",
    "rulebook_version",
    "subject_file_digest",
    "baseline",
    "subject_file_path",
    "preimages"
  ],
  "properties": {
    "baseline_version": {
      "const": "1.0"
    },
    "spec_version": {
      "const": "1.0"
    },
    "rulebook_version": {
      "type": "string",
      "maxLength": 32
    },
    "subject_file_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "kind",
              "dimension",
              "result",
              "rulebook_version",
              "tier",
              "condition",
              "k",
              "n"
            ],
            "properties": {
              "check_id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "plain",
                  "prompt",
                  "comparison"
                ]
              },
              "dimension": {
                "enum": [
                  "availability",
                  "execution",
                  "graceful-failure",
                  "robustness",
                  "response-correctness",
                  "determinism",
                  "cli-mcp-parity",
                  "provenance-honesty",
                  "completeness-signaling",
                  "output-conformance",
                  "flag-conformance",
                  "bounding",
                  "discoverability",
                  "error-message-quality",
                  "token-economy",
                  "side-effect-integrity",
                  "idempotency",
                  "destructive-guard",
                  "pii-secret-hygiene",
                  "steering",
                  "tool-description-efficacy"
                ]
              },
              "result": {
                "enum": [
                  "held",
                  "failed"
                ]
              },
              "rulebook_version": {
                "type": "string"
              },
              "tier": {
                "enum": [
                  "offline",
                  "live",
                  "replay",
                  "scripted",
                  "mixed"
                ]
              },
              "condition": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "k": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "n": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    },
    "subject_file_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "preimages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scheme",
          "probe",
          "runbook",
          "step",
          "index",
          "earlier",
          "dimension",
          "predicate",
          "path",
          "words",
          "offline_args",
          "env",
          "budget_seconds",
          "seed",
          "store",
          "bookkeeping",
          "parameters",
          "expected"
        ],
        "properties": {
          "scheme": {
            "const": "pql-check-id-1"
          },
          "probe": {
            "enum": [
              "discovery",
              "bare",
              "byte_bound",
              "exit_codes",
              "planted_secret",
              "store_unchanged",
              null
            ]
          },
          "runbook": {
            "type": [
              "string",
              "null"
            ]
          },
          "step": {
            "type": [
              "string",
              "null"
            ]
          },
          "index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "earlier": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "dimension": {
            "type": "string"
          },
          "predicate": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "words": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "offline_args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "budget_seconds": {
            "type": [
              "integer",
              "null"
            ]
          },
          "seed": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "store": {
            "type": [
              "string",
              "null"
            ]
          },
          "bookkeeping": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true,
            "description": "A probe's parameters as QE2 lists them."
          },
          "expected": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": true,
                "description": "An expected source as QE2 gives it."
              }
            ]
          }
        }
      }
    }
  }
}
