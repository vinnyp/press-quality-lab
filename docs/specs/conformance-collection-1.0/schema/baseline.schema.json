{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baseline.schema.json",
  "title": "Conformance collection 1.0 stored baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline_version",
    "spec_version",
    "rulebook_version",
    "subject_file_digest",
    "baseline"
  ],
  "properties": {
    "baseline_version": {
      "const": "1.0"
    },
    "spec_version": {
      "const": "1.0"
    },
    "rulebook_version": {
      "type": "string",
      "maxLength": 32
    },
    "subject_file_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "kind",
              "dimension",
              "result",
              "rulebook_version",
              "tier",
              "condition",
              "k",
              "n"
            ],
            "properties": {
              "check_id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "plain",
                  "prompt",
                  "comparison"
                ]
              },
              "dimension": {
                "enum": [
                  "availability",
                  "execution",
                  "graceful-failure",
                  "robustness",
                  "response-correctness",
                  "determinism",
                  "cli-mcp-parity",
                  "provenance-honesty",
                  "completeness-signaling",
                  "output-conformance",
                  "flag-conformance",
                  "bounding",
                  "discoverability",
                  "error-message-quality",
                  "token-economy",
                  "side-effect-integrity",
                  "idempotency",
                  "destructive-guard",
                  "pii-secret-hygiene",
                  "steering",
                  "tool-description-efficacy"
                ]
              },
              "result": {
                "enum": [
                  "held",
                  "failed"
                ]
              },
              "rulebook_version": {
                "type": "string"
              },
              "tier": {
                "enum": [
                  "offline",
                  "live",
                  "replay",
                  "scripted",
                  "mixed"
                ]
              },
              "condition": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "k": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "n": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    }
  }
}
