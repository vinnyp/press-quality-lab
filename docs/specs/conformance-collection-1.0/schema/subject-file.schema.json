{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subject-file.schema.json",
  "title": "Conformance collection 1.0 subject file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_file_version",
    "binary",
    "facts",
    "commands",
    "declared_count",
    "seed",
    "store",
    "offline",
    "bookkeeping",
    "secret",
    "runbooks",
    "markers",
    "prompts"
  ],
  "properties": {
    "subject_file_version": {
      "const": "1.0"
    },
    "binary": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "$ref": "#/$defs/placeholder"
        }
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "has_destructive_ops",
        "store_backed",
        "has_cli",
        "bounding"
      ],
      "properties": {
        "read_only": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        },
        "has_destructive_ops": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        },
        "store_backed": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        },
        "has_cli": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        },
        "bounding": {
          "oneOf": [
            {
              "enum": [
                "none",
                "declared"
              ]
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        }
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "declared_count": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        {
          "$ref": "#/$defs/placeholder"
        }
      ]
    },
    "seed": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/placeholder"
        }
      ]
    },
    "store": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^/\\u0000][^\\u0000]*$"
        },
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/placeholder"
        }
      ]
    },
    "offline": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/offline"
      }
    },
    "bookkeeping": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^/\\u0000][^\\u0000]*$"
      }
    },
    "secret": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/placeholder"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "kind",
            "reason",
            "token",
            "commands"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^/\\u0000][^\\u0000]*$"
            },
            "kind": {
              "enum": [
                "credential",
                "seeded_state"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 4096
            },
            "token": {
              "type": "string",
              "minLength": 8,
              "maxLength": 256
            },
            "commands": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "array",
                "minItems": 0,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "seeded_state"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "runbooks": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/runbook"
      }
    },
    "markers": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record",
          "dimension"
        ],
        "properties": {
          "record": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^{}:\\u0000-\\u001f]+$"
          },
          "dimension": {
            "$ref": "#/$defs/dimension"
          }
        }
      }
    },
    "prompts": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 64
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeholder"
      ],
      "properties": {
        "placeholder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "dimension": {
      "enum": [
        "availability",
        "execution",
        "graceful-failure",
        "robustness",
        "response-correctness",
        "determinism",
        "provenance-honesty",
        "completeness-signaling",
        "output-conformance",
        "flag-conformance",
        "bounding",
        "discoverability",
        "error-message-quality",
        "token-economy",
        "side-effect-integrity",
        "idempotency",
        "destructive-guard",
        "pii-secret-hygiene"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "words",
        "class",
        "writes",
        "exit_codes",
        "byte_bound",
        "budget_seconds"
      ],
      "properties": {
        "words": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "class": {
          "oneOf": [
            {
              "enum": [
                "safe",
                "destructive"
              ]
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        },
        "writes": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        },
        "exit_codes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        },
        "byte_bound": {
          "oneOf": [
            {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 1073741824
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        },
        "budget_seconds": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        }
      }
    },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies_to",
        "args",
        "env"
      ],
      "properties": {
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "env": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "computation"
          ],
          "properties": {
            "computation": {
              "$ref": "#/$defs/computation"
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "words",
        "budget_seconds",
        "checks"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^{}:\\u0000-\\u001f]+$"
        },
        "words": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "budget_seconds": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "predicate",
        "path",
        "expected",
        "precondition",
        "exit_codes"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/dimension"
        },
        "predicate": {
          "enum": [
            "exit_code",
            "stdout_equals",
            "stdout_json_equals",
            "stdout_contains",
            "stdout_not_contains",
            "stderr_contains",
            "stdout_bytes_at_most",
            "json_path_equals",
            "row_count",
            "stdout_empty"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "precondition": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "computation"
              ],
              "properties": {
                "computation": {
                  "$ref": "#/$defs/computation"
                }
              }
            }
          ]
        },
        "exit_codes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        }
      }
    },
    "runbook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^{}:\\u0000-\\u001f]+$"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "computation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "budget_seconds",
        "declared_files",
        "captures"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "budget_seconds": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        },
        "declared_files": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "captures": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^{}:\\u0000-\\u001f]+$"
          }
        }
      }
    }
  }
}
