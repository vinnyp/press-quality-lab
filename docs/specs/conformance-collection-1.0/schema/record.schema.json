{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "record.schema.json",
  "title": "Conformance collection 1.0 stored record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "spec_version",
    "request",
    "scope",
    "host",
    "subject_file_digest",
    "binary_digest",
    "seed_digest",
    "judge_input",
    "judge_output",
    "judge_rejected",
    "exit_code",
    "next_actions",
    "bookkeeping_excluded",
    "offline_settings",
    "subject_file_path"
  ],
  "properties": {
    "record_version": {
      "const": "1.0"
    },
    "spec_version": {
      "const": "1.0"
    },
    "request": {
      "enum": [
        "grade",
        "anchor"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "enum": [
          "conformance",
          "destructive",
          "steering",
          "compare"
        ]
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_version",
        "os_build",
        "arch"
      ],
      "properties": {
        "os_version": {
          "type": "string",
          "maxLength": 32
        },
        "os_build": {
          "type": "string",
          "maxLength": 32
        },
        "arch": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "subject_file_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binary_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "seed_digest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "judge_input": {
      "$ref": "judge-input.schema.json"
    },
    "judge_output": {
      "$ref": "judge-output.schema.json"
    },
    "judge_rejected": {
      "type": "boolean"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5,
        64,
        70
      ]
    },
    "next_actions": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "dimension",
              "reason",
              "action"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "dimension": {
                "type": "null"
              },
              "reason": {
                "enum": [
                  "arms_not_comparable",
                  "computation_failed",
                  "could_not_start",
                  "earlier_step_failed",
                  "empty_target",
                  "error_cap",
                  "harness_fault",
                  "input_missing",
                  "interval_undecided",
                  "judgement_unverified",
                  "live_not_run",
                  "network_attempted",
                  "network_unverifiable",
                  "no_evidence",
                  "placeholder_unfilled",
                  "precondition_unmet",
                  "trials_short"
                ]
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "dimension",
              "reason",
              "action"
            ],
            "properties": {
              "check_id": {
                "type": "null"
              },
              "dimension": {
                "enum": [
                  "availability",
                  "execution",
                  "graceful-failure",
                  "robustness",
                  "response-correctness",
                  "determinism",
                  "cli-mcp-parity",
                  "provenance-honesty",
                  "completeness-signaling",
                  "output-conformance",
                  "flag-conformance",
                  "bounding",
                  "discoverability",
                  "error-message-quality",
                  "token-economy",
                  "side-effect-integrity",
                  "idempotency",
                  "destructive-guard",
                  "pii-secret-hygiene",
                  "steering",
                  "tool-description-efficacy"
                ]
              },
              "reason": {
                "enum": [
                  "placeholder_unfilled",
                  "scope_not_requested",
                  "live_not_run"
                ]
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        ]
      }
    },
    "bookkeeping_excluded": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "offline_settings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "applies_to",
          "args",
          "env_names"
        ],
        "properties": {
          "applies_to": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "subject_file_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
